{
  "name": "bakieva-chat-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.ts\""
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.13.3",
    "telegram": "^2.26.22",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "prettier": "^3.9.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
